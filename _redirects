# Cloudflare Pages redirects
# Format: source destination status
#
# NOTE: Cloudflare Pages automatically serves .html files at clean URLs
# (e.g. /about.html -> /about) and 308-redirects the .html form. So pages
# that map 1:1 to a file need NO rule here — adding one causes a redirect loop.

# Seniority — filename differs from clean URL -> keep rewrites
/seniority        /seniority/seniority-list.html          200
/seniority/manage /seniority/seniority-management.html    200

# Blog — /blog serves blog/index.html (directory index).
# Posts live directly in blog/ and are served at clean URLs automatically
# (e.g. /blog/what-is-ai -> blog/what-is-ai.html). NO wildcard rule here —
# a /blog/* rewrite also matches /blog/, /blog/index.html and post files,
# causing rewrite loops -> 404.

# Favicon
/favicon.ico      /img/favicon.png                        200
